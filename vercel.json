{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/:slug((?!api$|dashboard$|admin$|portal$|legal$|pay$|payment$|congrat$|onboarding$|auth$)[a-zA-Z0-9_.]+)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
